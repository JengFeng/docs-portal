<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <staticContent>
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>
    <security>
      <!--
        HTTPS is enforced by the PHP entry point. The IIS access section is
        locked by the parent site on this server and cannot be set in an
        application-level web.config without causing HTTP 500.19.
      -->
      <requestFiltering>
        <requestLimits maxAllowedContentLength="526385152" />
        <hiddenSegments>
          <add segment="app" />
          <add segment="database" />
          <add segment="scripts" />
          <add segment="document-library" />
          <add segment=".git" />
          <add segment=".discord_uploads" />
          <add segment=".discord_outbox" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <!-- 正式站只允許 PHP 動態頁與靜態 assets，不保留公開 HTML 原型入口。 -->
          <add fileExtension=".html" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- X-Frame-Options is emitted by PHP: DENY by default, SAMEORIGIN only for allowlisted feedback_embed GET pages. -->
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
