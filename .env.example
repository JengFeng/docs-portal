# 請在 IIS／Windows 的受保護環境設定這些值；不要把實際密碼放入本檔或網站根目錄。
PORTAL_DB_HOST=sql-host.example.internal,1433
PORTAL_DB_NAME=TWWATER_PORTAL
PORTAL_DB_USERNAME=TWWATER_PORTAL_APP
# Base64 preserves password bytes in a Windows/IIS environment variable; it is not encryption.
PORTAL_DB_PASSWORD_B64=base64-of-the-database-password
PORTAL_DOCUMENT_ROOT=D:\TWWATER\published-documents
PORTAL_RATE_KEY=generate-a-random-32-byte-or-longer-secret
PORTAL_SESSION_SAVE_PATH=D:\TWWATER\runtime\sessions
# Must remain outside the public IIS application root. The preview worker has
# write access; the IIS AppPool receives read-only access.
PORTAL_PRESENTATION_PREVIEW_ROOT=D:\TWWATER\runtime\presentation-previews
PORTAL_PRESENTATION_RUNTIME_ROOT=D:\TWWATER\runtime\presentation-preview
# Private, non-IIS staging root. AppPool gets Modify; the document bridge is the only writer to PORTAL_DOCUMENT_ROOT.
PORTAL_PREUPLOAD_PREVIEW_ROOT=D:\TWWATER\runtime\pre-upload-previews
# Directional queue: AppPool Modify on requests, Read & Execute only on results; bridge identity Full Control.
PORTAL_STAGED_COMMIT_ROOT=D:\TWWATER\runtime\staged-commit-channel
PORTAL_LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
# Standalone image_exporter.exe (preferred for IIS isolation), or a Python executable with Pillow installed.
PORTAL_IMAGE_EXPORT_PYTHON=D:\TWWATER\runtime\pre-upload-previews\image-export-runtime\image_exporter.exe

# Google Web application OAuth client for portal sign-in. Keep the secret only in protected IIS settings.
PORTAL_GOOGLE_OAUTH_CLIENT_ID=000000000000-example.apps.googleusercontent.com
PORTAL_GOOGLE_OAUTH_CLIENT_SECRET=replace-with-protected-web-client-secret
PORTAL_GOOGLE_OAUTH_REDIRECT_URI=https://aiwork.ddns.net/gary/TWWATER/?action=google_callback

# 正式 HTTPS 站建議維持預設值。
PORTAL_COOKIE_PATH=/gary/TWWATER/
PORTAL_DB_ENCRYPT=1
PORTAL_DB_TRUST_SERVER_CERTIFICATE=0
# Secure same-path replacement and soft archive remain fail-closed until migration 029 and all activation tests pass.
PORTAL_DOCUMENT_MUTATIONS_ENABLED=0
